# Пользовательский systemd-сервис: один прогон фид-агента.
# Ставится в ~/.config/systemd/user/ ; запускается таймером feed-agent.timer.
#
# Ключ провайдера берётся из EnvironmentFile, который наполняет брокер `secret`
# (Vaultwarden). Файл — вне git, права 600. Пример наполнения (руками или из install.sh):
#   mkdir -p ~/.config/feed-agent
#   printf 'OPENROUTER_API_KEY=%s\n' "$(secret get openrouter/api-key)" \
#       > ~/.config/feed-agent/env && chmod 600 ~/.config/feed-agent/env
[Unit]
Description=feed-agent — один прогон фильтра новостей
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/projects/feed-agent
EnvironmentFile=%h/.config/feed-agent/env
ExecStart=%h/projects/feed-agent/.venv/bin/python -m feed_agent --once
