# Пользовательский systemd-сервис: Telegram-бот фид-агента (всегда на связи).
# Бот сам гоняет прогон по расписанию (сбор → фильтр → выжимка → дайджест с кнопками) и
# принимает нажатия [Подробнее]/👍/👎. Заменяет прежний oneshot-таймер.
#
# Ставится в ~/.config/systemd/user/ ; включить:
#   systemctl --user enable --now feed-agent-bot.service
#
# Токен бота — в EnvironmentFile, наполняется из Vaultwarden через брокер secret (значение
# не печатается). Разово, при разблокированном хранилище:
#   export BW_SESSION=$(bw unlock --raw)
#   mkdir -p ~/.config/feed-agent
#   printf 'FEED_BOT_TOKEN={{telegram/mycelium-charlie-news-bot}}\n' > /tmp/feedenv.tpl
#   mv "$(secret render /tmp/feedenv.tpl)" ~/.config/feed-agent/env && chmod 600 ~/.config/feed-agent/env
#   rm -f /tmp/feedenv.tpl
[Unit]
Description=feed-agent — Telegram-бот (дайджест новостей + Подробнее/реакции)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/projects/feed-agent
# PATH нужен, чтобы нашлись claude (выжимка) и notify (если понадобится).
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=%h/.config/feed-agent/env
ExecStart=%h/projects/feed-agent/.venv/bin/python -m feed_agent.bot
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
