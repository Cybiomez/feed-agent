# --- секреты и локальные данные (в git не попадают) ---
# Ключи провайдеров моделей, токены — только в хранилище (Vaultwarden через `secret`)
# или в окружении systemd, никогда в репозитории.
*.env
.env
# Реальные конфиги (копии из *.example) — вне git
config/settings.toml
config/sources.toml
config/profile.md
# Данные (SQLite-база новостей/оценок/реакций)
data/
*.db
*.sqlite3

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/

# --- прочее ---
.DS_Store
*.log
